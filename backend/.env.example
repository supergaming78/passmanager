# Copie ce fichier en `.env` puis remplis les valeurs reelles.
# Voir README.md pour le detail de chaque variable.

# --- Obligatoires ---
DATABASE_URL=sqlite:data/vault.db?mode=rwc
JWT_SECRET=change_moi_au_moins_32_caracteres_aleatoires
PASSWORD_PEPPER=change_moi_aussi_au_moins_32_caracteres
SMTP_USER=ton_compte@gmail.com
SMTP_PASS=mot_de_passe_application_smtp

# --- Optionnelles (valeurs par defaut indiquees) ---
APP_ENV=development
PORT=3000
SMTP_HOST=smtp.gmail.com
ACCESS_TOKEN_SECONDS=600
REFRESH_TOKEN_HOURS=24
REFRESH_TOKEN_SHORT_SECONDS=5
ALLOWED_ORIGINS=http://localhost:5173
# ^ Si tu utilises aussi l'extension navigateur : ajouter chrome-extension://<id> (une seule
#   origine couvre Chrome/Edge/Brave/Opera/Vivaldi desktop ET tout navigateur Chromium sur
#   Android, ex: Quetta) ET/OU moz-extension://<uuid> pour Firefox (uuid different par profil,
#   desktop et Android comptent comme deux profils distincts) - voir
#   extension/README.md#configuration-requise-cote-backend pour le detail complet.
# ADMIN_EMAIL=toi@example.com
# TRUST_PROXY_HEADERS=false
# ^ A ACTIVER (true) UNIQUEMENT si ce backend tourne derriere un reverse proxy de confiance
#   (ex: nginx) qui ecrase lui-meme les en-tetes X-Forwarded-For/X-Real-Ip/Forwarded avant de les
#   transmettre. Sans un tel proxy, laisser a false (defaut) : sinon n'importe quel client peut
#   falsifier ces en-tetes pour contourner completement le rate limiting.
