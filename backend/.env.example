# Copie ce fichier en `.env` puis remplis les valeurs reelles.
# Voir README.md pour le detail de chaque variable.

# --- Obligatoires ---
DATABASE_URL=sqlite:data/vault.db?mode=rwc
JWT_SECRET=change_moi_au_moins_32_caracteres_aleatoires
PASSWORD_PEPPER=change_moi_aussi_au_moins_32_caracteres
SMTP_USER=ton_compte@gmail.com
SMTP_PASS=mot_de_passe_application_smtp

# --- Optionnelles (valeurs par defaut indiquees) ---
APP_ENV=development
PORT=3000
SMTP_HOST=smtp.gmail.com
ACCESS_TOKEN_SECONDS=600
REFRESH_TOKEN_HOURS=24
REFRESH_TOKEN_SHORT_SECONDS=5
ALLOWED_ORIGINS=http://localhost:5173,http://tauri.localhost,tauri://localhost
# ^ http://localhost:5173 : uniquement utile en developpement (npm run tauri dev), sans effet sur
#   l'app packagee/installee - laisser quand meme, inoffensif.
# ^ http://tauri.localhost ET tauri://localhost : OBLIGATOIRES pour que l'app desktop/Android
#   PACKAGEE (le vrai .exe/.apk installe, pas le mode dev) puisse parler au backend - sans les
#   DEUX, le CORS bloque silencieusement toutes ses requetes. Windows et Android utilisent
#   "http://tauri.localhost" (le prefixe de schema Tauri expose comme un nom d'hote http, pas
#   comme un vrai schema d'URL, une contrainte de WebView2/Android WebView) ; macOS et Linux
#   utilisent "tauri://localhost" (schema personnalise, supporte nativement la par WKWebView/
#   WebKitGTK) - inclure les deux couvre toutes les plateformes sans avoir a savoir laquelle sera
#   utilisee.
# ^ Si tu utilises aussi l'extension navigateur : ajouter chrome-extension://<id> (une seule
#   origine couvre Chrome/Edge/Brave/Opera/Vivaldi desktop ET tout navigateur Chromium sur
#   Android, ex: Quetta) ET/OU moz-extension://<uuid> pour Firefox (uuid different par profil,
#   desktop et Android comptent comme deux profils distincts) - voir
#   extension/README.md#configuration-requise-cote-backend pour le detail complet.
# ADMIN_EMAIL=toi@example.com
# TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Geolocalisation HORS LIGNE des adresses IP (panneau Administration)
# ---------------------------------------------------------------------------
# Optionnel. Sans ce reglage, la colonne "Origine" reste vide et rien n'est telecharge.
#
# Chemin d'un fichier .mmdb LOCAL. La resolution se fait entierement sur ce serveur :
# aucune adresse de tes utilisateurs n'est jamais envoyee a un service tiers.
#
# Base libre, sans compte a creer (~8 Mo, a rafraichir de temps en temps) :
#   curl -L -o dbip-country.mmdb.gz \
#     "https://download.db-ip.com/free/dbip-country-lite-$(date +%Y-%m).mmdb.gz"
#   gunzip dbip-country.mmdb.gz
#
# En Docker, depose simplement le fichier dans ./data/ (deja monte sur /app/data) et
# donne ici le chemin VU DEPUIS LE CONTENEUR, pas celui de ta machine.
# GEOIP_DATABASE_PATH=/app/data/dbip-country.mmdb
# ^ A ACTIVER (true) UNIQUEMENT si ce backend tourne derriere un reverse proxy de confiance
#   (ex: nginx) qui ecrase lui-meme les en-tetes X-Forwarded-For/X-Real-Ip/Forwarded avant de les
#   transmettre. Sans un tel proxy, laisser a false (defaut) : sinon n'importe quel client peut
#   falsifier ces en-tetes pour contourner completement le rate limiting.
